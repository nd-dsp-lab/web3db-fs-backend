# Node
node_modules/
**/node_modules/

# Environment
.env
.env.*
!.env.example
.venv 

# Python
__pycache__/
*.pyc
.venv/
venv/

# IPFS node data (do not track; keystore under here is sensitive)
ipfs/data/
**/ipfs/data/
*.cache

# Hardhat / solidity build artifacts (if present at repo root)
artifacts/
cache/
typechain/
typechain-types/

# Logs, OS, editors, CI
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.vscode/
.idea/
.vim/
*.swp
nohup.out

# Test / coverage
coverage/
.coverage
.pytest_cache/

# don't accidentally track local runtime state (sensitive)
funded_addresses.json
thumbs/
# Sealed thumbnail cache: ciphertext, but it is still user file content.
thumbs-sealed/
auth_secret.txt
secrets/

# SGX build outputs. Rendered by sgx/Makefile and produced by the signing
# flow, per host and per build — the template and the scripts are the
# sources, these are not. Committing a measurement would also make it look
# authoritative when the only trustworthy one is what the running enclave
# reports.
sgx/*.manifest
sgx/*.manifest.sgx
sgx/*.mrenclave
sgx/*.sig
sgx/enclave-pub.pem

# local-only documentation
docs/
