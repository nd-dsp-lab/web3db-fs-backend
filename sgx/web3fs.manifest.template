# Gramine manifest for running the Web3FS backend inside an SGX enclave.
#
# Rendered by `make` (see Makefile here) with the paths of the checkout and
# venv baked in. The app sees a clean /web3fs prefix regardless of where the
# checkout lives on the host, so every relative path in the code (../.env,
# ../../thumbs, ...) resolves the same way it does under plain python.
#
# Secrets (.env) live in the encrypted mount at /web3fs/secrets: bytes on the
# host disk are ciphertext under a key derived from SGX sealing (MRSIGNER —
# only enclaves signed with our enclave key can derive it). The same template
# renders two enclaves: the server, and with provision=1 a one-shot tool that
# reads a plaintext .env on stdin and writes it into the sealed mount.
# TLS-in-enclave and attestation are phases 4-5.

libos.entrypoint = "{{ entrypoint }}"

loader.log_level = "{{ log_level }}"

# The entrypoint is the system python, not venv/bin/python3, because Gramine
# wants the real ELF binary. The venv is applied via PYTHONPATH instead of
# activation; the app dir rides along so `uvicorn server:app` imports without
# a chdir.
{% if provision == "1" %}
loader.argv = ["python3", "/web3fs/sgx/provision.py"]
{% elif csr == "1" %}
# Generate a TLS keypair inside the enclave and emit its CSR — the private
# key is written to the sealed mount and never exists anywhere else.
loader.argv = ["python3", "/web3fs/sgx/csr.py"]
{% elif promote == "1" %}
# Activate the pending key/certificate pair once the CA has answered.
loader.argv = ["python3", "/web3fs/sgx/promote.py"]
{% elif export == "1" %}
# Backup tool for the file-content master key — see export-key.py. Delete
# its signed artifacts after use; they are a key-extraction capability.
loader.argv = ["python3", "/web3fs/sgx/export-key.py"]
{% elif tls == "1" %}
# End-to-end TLS: the session terminates inside the enclave. The key was
# provisioned into the sealed mount, so no host — the reverse proxy
# included — can decrypt the traffic; the proxy blind-forwards by SNI.
loader.argv = [
  "python3", "-m", "uvicorn", "server:app",
  "--host", "{{ host }}", "--port", "{{ port }}",
  "--ssl-keyfile", "/web3fs/secrets/tls/key.pem",
  "--ssl-certfile", "/web3fs/secrets/tls/cert.pem",
]
{% else %}
loader.argv = [
  "python3", "-m", "uvicorn", "server:app",
  "--host", "{{ host }}", "--port", "{{ port }}",
]
{% endif %}

loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}:/usr/lib:/usr/{{ arch_libdir }}"
loader.env.PATH = "/usr/bin:/bin"
loader.env.HOME = "/web3fs"
loader.env.PYTHONPATH = "/web3fs/app:/web3fs/venv/lib/python3.12/site-packages"
# The app dirs are measured read-only mounts; a .pyc write would fail anyway,
# so tell CPython not to try.
loader.env.PYTHONDONTWRITEBYTECODE = "1"
# configure.py loads its settings from the sealed copy, not a host file.
loader.env.ENV_FILE = "/web3fs/secrets/.env"
# The token-signing secret lives in the sealed mount too, and security.py
# generates it there on first use if absent — so it need never be typed,
# stored, or carried by anyone.
loader.env.AUTH_SECRET_FILE = "/web3fs/secrets/auth_secret"

# Host env is NOT passed through (that would let the host operator inject
# e.g. a hostile INFURA_URL). All configuration comes from the .env file the
# app already loads itself.

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "{{ arch_libdir }}", uri = "file:{{ arch_libdir }}" },
  { path = "/usr", uri = "file:/usr" },
  { path = "/etc", uri = "file:/etc" },
  { type = "tmpfs", path = "/tmp" },

  { path = "/web3fs/app", uri = "file:{{ backend_root }}/app" },
  { path = "/web3fs/sgx", uri = "file:{{ backend_root }}/sgx" },
  { path = "/web3fs/venv", uri = "file:{{ venv }}" },
  # Encrypted (sealed) storage: transparent AES-GCM per file, key derived
  # from MRSIGNER via SGX sealing — never present on the host. Under
  # gramine-direct the key is an insecure all-zero stub, so dev runs work
  # but seal nothing.
  { type = "encrypted", path = "/web3fs/secrets", uri = "file:{{ backend_root }}/secrets", key_name = "_sgx_mrsigner" },
  { path = "/web3fs/funded_addresses.json", uri = "file:{{ backend_root }}/funded_addresses.json" },
  { path = "/web3fs/logs", uri = "file:{{ backend_root }}/logs" },
  # Thumbnails are decrypted previews of sealed files, so their cache is
  # sealed too. Fresh host dir (not thumbs/): an encrypted mount can't read
  # pre-existing plaintext files, they'd 500 on open.
  { type = "encrypted", path = "/web3fs/thumbs", uri = "file:{{ backend_root }}/thumbs-sealed", key_name = "_sgx_mrsigner" },
]

# DCAP quotes for /attestation — Gramine exposes /dev/attestation/* inside
# the enclave and routes quote generation through the host's aesmd.
sgx.remote_attestation = "dcap"

# Sapphire Rapids: EDMM adds EPC pages on demand instead of pre-faulting the
# whole enclave_size at startup, so a generous size costs nothing.
sgx.edmm_enable = true
sgx.enclave_size = "8G"
# uvicorn's event loop plus anyio's default 40-thread pool plus headroom.
sgx.max_threads = 128

# Let `kill`/restart.sh stop the server cleanly from outside the enclave.
sys.enable_sigterm_injection = true

# Everything the interpreter may execute or import is measured: a tampered
# library fails its hash check at open() instead of running.
sgx.trusted_files = [
  "file:{{ entrypoint }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:{{ arch_libdir }}/",
  "file:/usr/{{ arch_libdir }}/",
{% for path in python.get_sys_path(entrypoint) %}
  "file:{{ path }}{{ '/' if path.is_dir() else '' }}",
{% endfor %}
  "file:{{ venv }}/lib/",
  "file:{{ backend_root }}/app/",
  "file:{{ backend_root }}/sgx/provision.py",
  "file:{{ backend_root }}/sgx/export-key.py",
  "file:{{ backend_root }}/sgx/csr.py",
  "file:{{ backend_root }}/sgx/promote.py",
]

# Mutable or host-managed files the enclave reads/writes without integrity
# protection. Secrets are NOT here anymore — they ride the encrypted mount.
# thumbs/ and logs/ stay plain until phase 3 decides what leaks through them.
sgx.allowed_files = [
  "file:/etc/resolv.conf",
  "file:/etc/hosts",
  "file:/etc/host.conf",
  "file:/etc/nsswitch.conf",
  "file:/etc/localtime",
  "file:/etc/ssl/",
  "file:/etc/ca-certificates/",
  "file:/usr/lib/ssl/",
  "file:{{ backend_root }}/funded_addresses.json",
  "file:{{ backend_root }}/logs/",
]
