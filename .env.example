# Copy to .env and fill in. Never commit the real .env — it holds a funded
# wallet key and the token-signing secret.
#
# Do NOT add UVICORN_RELOAD here. Auto-reload is a development-only setting
# and dev.sh sets it; this file's real counterpart gets copied to the
# production server, which would re-enable the file watcher there.

# --- required ---
# Deployed FileStorage contract on Sepolia.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Sepolia RPC. Set the key, or INFURA_URL for a full endpoint.
INFURA_API_KEY=
# INFURA_URL=https://sepolia.infura.io/v3/...

# Faucet wallet that drips gas to new users. Holds real SepETH.
PRIVATE_KEY=

# HMAC key for download tokens: 32 bytes, hex encoded.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates auth_secret.txt on first run instead.
AUTH_SECRET=

# --- sharing by email (Privy) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- share notification email (Amazon SES over SMTP) ---
SES_SMTP_USER=
SES_SMTP_PASSWORD=
# SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# NOTIFY_FROM=Web3FS <notifications@fs.web3db.org>
# APP_URL=https://fs.web3db.org

# --- optional ---
ETHERSCAN_API_KEY=

# Extra browser origins allowed to call the API, comma-separated. The
# defaults in configure.py already cover localhost:3000 and fs.web3db.org.
# CORS_ORIGINS=https://staging.example.org

# Point at a different kubo node. Defaults are the local one.
# IPFS_API_URL=http://localhost:5001/api/v0
# IPFS_GATEWAY_URL=http://localhost:8082/ipfs
